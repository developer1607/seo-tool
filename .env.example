AUTH_SECRET=change-me-to-a-long-random-string
APP_ENCRYPTION_KEY=change-me-32-chars-minimum!!
APP_URL=http://localhost:3000
PORT=4000
API_ORIGIN=http://127.0.0.1:4000
# Optional seed (npm run init-db). Prefer matching your Gmail for SSO:
# SEED_ADMIN_EMAIL=searcheno1@gmail.com
# SEED_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared callback for portal SSO + Google data OAuth (mode in state).
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Continue with Google only works for an existing ADMIN whose email matches the Gmail.
# Optional legacy header (Google sunset tokens 2026-09-09; Cloud project access is required).
# GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional; auto-tries 25→19 if unset
# GOOGLE_ADS_API_VERSION=25
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/meta/callback
# META_GRAPH_VERSION=v21.0
