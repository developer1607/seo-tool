AUTH_SECRET=change-me-to-a-long-random-string
APP_ENCRYPTION_KEY=change-me-32-chars-minimum!!
APP_URL=http://localhost:3000
PORT=4000
API_ORIGIN=http://127.0.0.1:4000
# PostgreSQL (required). Local options:
# 1) npm run db:pg:start  (embedded UTF-8 cluster, no Docker / no system install) → port 5434
# 2) Or point at any reachable Postgres:
# DATABASE_URL=postgresql://webastral:webastral@127.0.0.1:5434/webastral
DATABASE_URL=
# Optional seed (npm run db:init). Prefer matching your Gmail for SSO:
# SEED_ADMIN_EMAIL=searcheno1@gmail.com
# SEED_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared callback for portal SSO + Google data OAuth (mode in state).
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Continue with Google only works for an existing ADMIN whose email matches the Gmail.
# Optional legacy header (Google sunset tokens 2026-09-09; Cloud project access is required).
# GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional; auto-tries 25→19 if unset
# GOOGLE_ADS_API_VERSION=25
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/meta/callback
# META_GRAPH_VERSION=v21.0
# Staging / prod: use separate OAuth clients (or add matching redirect URIs in each Console).
# APP_URL, GOOGLE_REDIRECT_URI, and META_REDIRECT_URI must match the public host exactly.
# See docs/03-qa/01-alpha/P1_OPS_AND_POLISH.md §3.
