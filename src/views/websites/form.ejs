<% if (error) { %>
  <div class="banner banner-error"><%= error %></div>
<% } %>

<form class="form" method="post" action="/websites">
  <% if (user.role === 'ADMIN') { %>
    <label>Client
      <select name="client_id" required>
        <option value="">Select…</option>
        <% clients.forEach(function (c) { %>
          <option value="<%= c.id %>"><%= c.name %> (<%= c.email %>)</option>
        <% }) %>
      </select>
    </label>
  <% } %>
  <label>Website name
    <input name="name" required />
  </label>
  <label>Primary domain
    <input name="domain" placeholder="https://example.com" required />
  </label>
  <label>Timezone
    <input name="timezone" value="Asia/Kolkata" />
  </label>
  <label>Currency
    <input name="currency" value="INR" />
  </label>
  <button class="btn btn-primary" type="submit">Create Website</button>
</form>
