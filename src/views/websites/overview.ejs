<%- include('tabs') %>

<% data.banners.forEach(function (b) { %>
  <div class="banner banner-<%= b.type === 'error' ? 'error' : 'warn' %>">
    <%= b.text %>
    <% if (b.href) { %> — <a href="<%= b.href %>">Fix</a><% } %>
  </div>
<% }) %>

<div class="kpi-strip">
  <div class="kpi">
    <div class="label">Organic clicks</div>
    <div class="value"><%= data.kpis.organic_clicks %></div>
  </div>
  <div class="kpi">
    <div class="label">Sessions</div>
    <div class="value"><%= data.kpis.sessions %></div>
  </div>
  <div class="kpi">
    <div class="label">Meta spend</div>
    <div class="value"><%= Number(data.kpis.meta_spend).toFixed(0) %></div>
  </div>
  <div class="kpi">
    <div class="label">Conversions</div>
    <div class="value"><%= data.kpis.primary_conversions %></div>
  </div>
  <div class="kpi">
    <div class="label">Onboarding</div>
    <div class="value" style="font-size:0.85rem;font-family:var(--font);"><%= data.setup.onboarding_status %></div>
  </div>
</div>

<div class="panel">
  <div class="panel-hd">
    <span>Data sources</span>
    <a class="btn btn-ghost btn-sm" href="/websites/<%= website.id %>/integrations">Manage</a>
  </div>
  <div class="table-wrap">
    <% if (!data.setup.connections.length) { %>
      <div class="empty">No connections yet. Open Integrations to connect GA4, Search Console, or Meta.</div>
    <% } else { %>
      <table class="table">
        <thead>
          <tr><th>Provider</th><th>Status</th><th>Account</th><th>Last sync</th></tr>
        </thead>
        <tbody>
          <% data.setup.connections.forEach(function (c) { %>
            <tr>
              <td><%= c.provider.replace(/_/g, ' ') %></td>
              <td>
                <span class="pill <%= c.status === 'ACTIVE' ? 'pill-ok' : (c.status === 'ERROR' || c.status === 'NEEDS_REAUTH' ? 'pill-err' : 'pill-warn') %>">
                  <%= c.status %>
                </span>
              </td>
              <td class="muted"><%= c.label %></td>
              <td class="muted"><%= c.last_sync_at || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
