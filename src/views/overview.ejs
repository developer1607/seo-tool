<% if (alerts && alerts.length) { %>
  <% alerts.forEach(function (a) { %>
    <div class="banner banner-<%= a.severity === 'error' ? 'error' : 'warn' %>">
      <strong><%= a.title %></strong>
      <% if (a.href) { %> — <a href="<%= a.href %>">Open</a><% } %>
    </div>
  <% }) %>
<% } %>

<div class="page-toolbar">
  <span class="hint"><%= data.kpis.range_label %> · snapshots after sync</span>
  <% if (user.role === 'ADMIN') { %>
    <a class="btn btn-primary btn-sm" href="/clients">Clients</a>
  <% } else { %>
    <a class="btn btn-primary btn-sm" href="/websites">Websites</a>
  <% } %>
</div>

<div class="kpi-strip">
  <% if (user.role === 'ADMIN') { %>
    <div class="kpi">
      <div class="label">Clients</div>
      <div class="value"><%= data.totals.clients %></div>
    </div>
  <% } %>
  <div class="kpi">
    <div class="label">Websites</div>
    <div class="value"><%= data.totals.websites %></div>
  </div>
  <div class="kpi">
    <div class="label">Connected</div>
    <div class="value"><%= data.totals.connections_active %></div>
  </div>
  <div class="kpi">
    <div class="label">Attention</div>
    <div class="value"><%= (data.totals.connections_error || 0) + (data.totals.connections_needs_reauth || 0) %></div>
  </div>
  <div class="kpi">
    <div class="label">Organic clicks</div>
    <div class="value"><%= data.kpis.organic_clicks %></div>
  </div>
  <div class="kpi">
    <div class="label">Sessions</div>
    <div class="value"><%= data.kpis.sessions %></div>
  </div>
  <div class="kpi">
    <div class="label">Meta spend</div>
    <div class="value"><%= Number(data.kpis.meta_spend).toFixed(0) %></div>
  </div>
  <div class="kpi">
    <div class="label">Conversions</div>
    <div class="value"><%= data.kpis.primary_conversions %></div>
  </div>
</div>
