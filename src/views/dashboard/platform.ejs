<%- include('../partials/datebar') %>

<div class="page-toolbar">
  <span class="hint"><%= selectedClient.name %> · <%= title %></span>
  <% if (status && status.status !== 'ACTIVE') { %>
    <a class="btn btn-primary btn-sm" href="/integrations">Connect <%= title %></a>
  <% } %>
</div>

<% if (status && (status.status === 'ERROR' || status.status === 'NEEDS_REAUTH')) { %>
  <div class="banner banner-error">
    <%= title %> unavailable<%= status.last_error ? ': ' + status.last_error : '' %>. Other platforms still load.
  </div>
<% } %>

<div class="kpi-strip">
  <div class="kpi">
    <div class="label">Status</div>
    <div class="value" style="font-size:0.85rem;font-family:var(--font);"><%= status ? status.status.replace(/_/g, ' ') : '—' %></div>
  </div>
  <div class="kpi">
    <div class="label">Clicks</div>
    <div class="value"><%= kpis.clicks %></div>
  </div>
  <div class="kpi">
    <div class="label">Impressions</div>
    <div class="value"><%= kpis.impressions %></div>
  </div>
  <div class="kpi">
    <div class="label">Spend</div>
    <div class="value"><%= Number(kpis.spend).toFixed(0) %></div>
  </div>
  <div class="kpi">
    <div class="label">Conversions</div>
    <div class="value"><%= kpis.primary_conversions %></div>
  </div>
  <div class="kpi">
    <div class="label">Sessions</div>
    <div class="value"><%= kpis.sessions %></div>
  </div>
</div>

<div class="panel">
  <div class="panel-hd">
    <span>Detail table</span>
    <span class="muted">Column customize later (FR-023)</span>
  </div>
  <div class="table-wrap">
    <% if (!rows || !rows.length) { %>
      <div class="empty">No rows for this range yet. Connect + sync in Integrations.</div>
    <% } else { %>
      <table class="table">
        <thead><tr><th>Name</th><th>Impressions</th><th>Clicks</th><th>Spend</th><th>Conv.</th></tr></thead>
        <tbody>
          <% rows.forEach(function (r) { %>
            <tr>
              <td><%= r.name %></td>
              <td><%= r.impressions %></td>
              <td><%= r.clicks %></td>
              <td><%= r.spend %></td>
              <td><%= r.conversions %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<div class="panel">
  <div class="panel-hd">Trend</div>
  <div class="panel-bd">
    <p class="muted" style="margin:0;">Chart.js series after first sync (FR-013).</p>
  </div>
</div>
