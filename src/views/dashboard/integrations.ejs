<div class="page-toolbar">
  <span class="hint">Connect platforms for <strong><%= selectedClient.name %></strong>. Tokens stay on this client only.</span>
</div>

<div class="panel">
  <div class="panel-hd">Data sources</div>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>Platform</th><th>Status</th><th>Account</th><th>Last sync</th><th></th></tr>
      </thead>
      <tbody>
        <% platforms.forEach(function (p) { %>
          <tr>
            <td><strong><%= p.label %></strong></td>
            <td>
              <span class="pill <%= p.status === 'ACTIVE' ? 'pill-ok' : (p.status === 'ERROR' || p.status === 'NEEDS_REAUTH' ? 'pill-err' : 'pill-muted') %>">
                <%= p.status.replace(/_/g, ' ') %>
              </span>
            </td>
            <td class="muted"><%= p.account_name || '—' %></td>
            <td class="muted"><%= p.last_sync_at || '—' %></td>
            <td>
              <button class="btn btn-primary btn-sm" type="button" disabled title="OAuth next">Connect</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% platforms.filter(function (p) { return p.last_error; }).forEach(function (p) { %>
  <div class="banner banner-error"><%= p.label %>: <%= p.last_error %></div>
<% }) %>
